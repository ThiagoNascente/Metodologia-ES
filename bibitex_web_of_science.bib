@inproceedings{ WOS:001795582100029,
Author = {Barbierato, Enrico and Gatti, Alice},
Book-Group-Author = {IEEE},
Title = {Cultural Heritage in the Age of Red and Green AI: Lessons from Four Case
   Studies},
Booktitle = {2025 IEEE INTERNATIONAL CONFERENCE ON CYBER HUMANITIES, IEEE-CH},
Year = {2025},
Pages = {180-185},
Note = {2025 International Conference on Cyber Humanities-IEEE-CH, Florence,
   ITALY, SEP 08-10, 2025},
Organization = {Institute of Electrical and Electronics Engineers Inc; IEEE Systems Man
   and Cybernetics Society; Roma Tre University; Dell Technologies},
Abstract = {The increasing adoption of Artificial Intelligence (AI) in Cultural
   Heritage (CH) raises important questions about its environmental
   sustainability. While AI promises enhanced restoration, visualization,
   and analysis capabilities, it often comes with a substantial energy
   footprint. This study explores the tension between Red AI-a term
   referring to high-performing but computationally expensive and
   environmentally taxing AI models-and Green AI, which emphasizes
   energy-efficient and sustainable Machine Learning (ML) practices.
   Through four case studies involving image enhancement, restoration,
   virtual heritage, and optical character recognition, we compare the
   energy consumption and execution times of AI-based and traditional
   approaches. The experiments were conducted using standard computer
   vision models and tools on a typical GPU-enabled workstation. Our
   findings reveal that although AI methods often yield superior results,
   they also tend to consume significantly more energy than traditional
   alternatives.},
