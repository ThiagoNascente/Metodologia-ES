
@article{ WOS:001203466500031,
Author = {Kim, Hyunbum and Ben-Othman, Jalel and Kim, Daeyoung},
Title = {Harmonized All-Ways Security Surveillance and Disaster Prevention in
   Smart Eco-Cities},
Journal = {IEEE INTERNET OF THINGS JOURNAL},
