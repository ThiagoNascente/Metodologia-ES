@inproceedings{ WOS:001544995100019,
Author = {Trinci, Tomaso and Magistri, Simone and Verdecchia, Roberto and
   Bagdanov, Andrew D.},
Editor = {DelBue, A and Canton, C and Pont-Tuset, J and Tommasi, T},
Title = {How Green Is Continual Learning, Really? Analyzing the Energy
   Consumption in Continual Training of Vision Foundation Models},
Booktitle = {COMPUTER VISION-ECCV 2024 WORKSHOPS, PT XXII},
Series = {Lecture Notes in Computer Science},
