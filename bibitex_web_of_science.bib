Title = {The Impact of Crossover and Mutation on Carbon Emissions in Real-Coded
   Genetic Algorithm: An Empirical Study},
Booktitle = {ADVANCES IN COMPUTATIONAL INTELLIGENCE: MICAI 2025 INTERNATIONAL
   WORKSHOPS, HIS 2025, CIAPP 2025, WILE 2025, CHARAL 2025, ECSI 2025, PT
   II},
Series = {Lecture Notes in Artificial Intelligence},
Year = {2026},
