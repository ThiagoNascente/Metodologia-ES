@article{ WOS:001513091500004,
Author = {Ali, Aatif and Habib, Shazia and Khan, Zeeshan and Thaljaoui, Adel and
   Sun, Mei and Muhammad, Taseer},
Title = {An artificial neural network implementation on novel tetra hybrid
   nanofluid model: Case study of solar wind turbines},
Journal = {ENGINEERING APPLICATIONS OF ARTIFICIAL INTELLIGENCE},
Year = {2025},
Volume = {158},
Number = {A},
Month = {OCT 15},
Abstract = {This paper introduces a novel approach for examining heat transfer in
   photovoltaic hybrid wind turbines through the application of neural
   networks and Casson-Sutterby fluid dynamics. The research indicates that
   the integration of agglomerative tetra hybrid nanoparticles can markedly
   enhance the efficacy of solar wind turbines. Tetra hybrid nanofluid,
   characterized by its elevated thermal conductivity, specific heat
   capacity, and radiative heat transfer, serves as a more efficient heat
   source in solar turbines. This results in heightened heat production,
   radiation, and thermal radiation, hence augmenting thermal energy
   transfer. The proposed neural network approach demonstrates the highest
   efficacy, as the Absolute Error (AE) falls within the range 10-03 to
   10-08, the Mean Square Error (MSE) values lie in the range of 10-09 to
   10-10, all the Cases have performance values fall within the range 10-04
   to 10-05. The Error histograms values for 20 bins with zero errors are
   10-05 to 10-06. The regression approaches to 1, showing the best fit.
   Tetra hybrid nanofluids exhibit superior heat transmission
   characteristics, and neural network provides excellent results, thereby
   providing valuable insights into the optimization of thermal management
   in solar energy applications and the enhancement of the efficiency of
   solar-powered vehicles. Levenberg-Marquardt Backpropagation Neural
   Networks (LMBNNs) is extensively utilized in engineering and fluid
   mechanics for addressing intricate, nonlinear issues. Future research
   directions encompass the integration of LMBNNs with deep learning
   methodologies, real-time adaptive control, sophisticated nanofluid
   materials, Multiphysics modeling, computational fluid dynamics and
   Artificial Intelligence (AI) hybridization, as well as green AI and
   sustainable energy systems.},
