   Praca, Isabel},
Editor = {Adi, K and Bourdeau, S and Durand, C and Tong, VVT and Dulipovici, A and Kermarrec, Y and Garcia-Alfaro, J},
Title = {Intelligent Green Efficiency for Intrusion Detection},
Booktitle = {FOUNDATIONS AND PRACTICE OF SECURITY, FPS 2024, PT II},
