@inproceedings{ WOS:001756347300016,
Author = {Al-Zanbouri, Zainab},
Book-Group-Author = {IEEE},
Title = {Green AI and Sustainable Technology},
Booktitle = {2025 2ND INTERNATIONAL CONFERENCE ON ARTIFICIAL INTELLIGENCE, METAVERSE,
   AND CYBERSECURITY, ICAMAC},
Year = {2025},
Pages = {92-97},
Note = {2nd International Conference on Artificial Intelligence, Metaverse and
   Cybersecurity-ICAMAC, U ARAB EMIRATES, OCT 17-18, 2025},
Organization = {Rochester Institute Of Technology},
Abstract = {Although artificial intelligence (AI) continues to drive innovation
   across various industries, there is a growing concern about its
   environmental impact. Green AI aims to maximize energy efficiency
   without compromising functionality by reducing AI ` s carbon footprint.
   Our previous research in green computing provided valuable insights into
   sustainable AI techniques and formed a strong foundation in this field
   that is consistent with Green AI's objectives. The main objective of
   this research is to identify the key factors influencing energy
   consumption in AI models by analyzing their performance and comparing
   their energy usage. With this work, we hope to gain a better
   understanding of how to make AI models more energyefficient without
   sacrificing their efficacy. In this research we investigate energy
   consumption patterns in AI models using a real-world database, which
   includes various operations and configurations. The methodology we use
   involves comparing and analyzing AI models ` energy consumption and
   estimating carbon footprints. We conduct two experiments to measure and
   analyze the energy consumed by different deep learning kernels on edge
   hardware. The results reveal that energy usage differs widely depending
   on configurations and kernel complexity. Some operations are highly
   energy-intensive, while others are much more efficient. These insights
   can guide energy-aware model design and optimization for greener AI
   systems. The research findings help shift from resource-intensive AI
   toward more sustainable alternatives, highlighting the persistent need
   for environmentally aware AI practices. By implementing green AI
   concepts, the technology industry can continue to innovate ethically
   while reducing its environmental impact.},
