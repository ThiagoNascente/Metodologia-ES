@article{ WOS:001719547800034,
Author = {Kandakatla, Jayachander Reddy},
Title = {Retraining-Efficiency Score (RES): A Simple, Cost-Aware Promotion Rule
   for Green and Accurate Forecasting},
Journal = {IEEE ACCESS},
Year = {2026},
Volume = {14},
Pages = {41168-41180},
Abstract = {Deployed machine-learning models deteriorate as data, user behavior, and
   context drift. Fixed retraining schedules therefore waste operational
   resources and deployment bandwidth when drift is mild, yet allow
   avoidable error spikes when drift is severe. We propose the retraining
   efficiency score (RES), a one-line rule that, each week, decides whether
   to promote the candidate model trained on recent data as a simple
   guard-rail for Cost-aware model and Green AI operations. At every
   decision point RES compares the prospective reduction in mean absolute
   error (MAE) of the candidate model to its training time via a bounded
   efficiency score, and promotes only when this score exceeds a user-set
   threshold lambda is an element of (0,1) . A short online routine updates
   lambda every eight weeks from recent benefit-cost history, eliminating
   the need for offline grid search. We replay 2,320 runs across four
   public time-series benchmarks (NYC Taxi, M5 Retail, Wikipedia, Ausgrid
   Electricity) and four forecasting architectures (Transformer, Prophet,
   LightGBM, ARIMA), comparing against fixed-interval, random-budget,
   Page-Hinkley, CARA, and always/never promotion baselines under a common
   deployment-cost model. Across datasets and architectures, RES
   substantially reduces the number of model promotions relative to always
   promoting the latest candidate, extends the average lifetime of a
   deployed model from one week to several weeks, and improves MAE compared
   with both always and never promote baselines. Crucially, with a single
   global setting of lambda approximate to 0.3 , RES achieves a median
   approximate to 5\% and up to 45\% MAE reduction relative to static
   baselines while remaining robust to the choice of lambda . Because our
   experimental protocol trains a candidate weekly to measure potential
   benefits, the reported savings represent a conservative lower bound,
   reflecting only the avoided downstream deployment and validation
   overhead.},
