@inproceedings{ WOS:001793516600406,
Author = {Rossi, Domenico and Citarella, Alessia Auriemma and De Marco, Fabiola
   and Tortora, Genoveffa},
Book-Group-Author = {IEEE},
Title = {Green AI for Healthcare: Efficient ECG Biometrics through Model
   Compression},
Booktitle = {2025 IEEE INTERNATIONAL CONFERENCE ON BIG DATA, BIGDATA},
Series = {IEEE International Conference on Big Data},
Year = {2025},
Pages = {7703-7708},
Note = {2025 IEEE International Conference on Big Data-BigData, Macau, PEOPLES R
   CHINA, DEC 08-11, 2025},
Organization = {Institute of Electrical and Electronics Engineers Inc},
Abstract = {Artificial intelligence (AI) has become a cornerstone of modern
   healthcare, yet its deployment raises critical concerns about energy
   efficiency and environmental impact. While much research emphasizes
   accuracy and training optimization, inference-time sustainability
   remains largely overlooked despite being the most frequent and
   resource-intensive phase in clinical use. In this work, we present a
   sustainable AI framework for ECG-based biometric identification that
   explicitly targets inference efficiency. Using the MIT-BIH Arrhythmia
   dataset, we trained a baseline CNN (CardioIdNet) that achieved 98.2\%
   accuracy, 98.2\% precision, recall, and F1-score, with an AUC of 99.9\%.
   To reduce its computational footprint, we applied knowledge distillation
   and post-training quantization. The distilled student model preserved
   almost all predictive performance (96.9\% accuracy) while reducing model
   size by 82\%, inference latency by 56\%, and energy consumption by 66\%.
   The quantized model minimized CPU load and memory footprint but revealed
   hardware-dependent sustainability trade-offs. All models were assessed
   across performance, energy, carbon emissions (via ISPRAcertified
   factors), and computational load. Our results provide a reproducible
   pipeline for deploying reliable and environmentally responsible AI in
   healthcare, aligning ECG biometrics with the broader paradigm of Green
   AI.},
