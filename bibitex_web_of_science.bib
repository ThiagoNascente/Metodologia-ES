Author = {Elbasi, Ersin and Ibrahim Alzoubi, Yehia and Topcu, Ahmet E. and Nadeem,
   Muhammad},
Title = {Green AI for Smart Agriculture: Energy-Efficient Predictive Models for
   Crop Yield and Resource Management},
Journal = {IEEE ACCESS},
