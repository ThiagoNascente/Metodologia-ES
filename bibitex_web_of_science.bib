Title = {Optimizing YOLOv5 for Green AI: A Study on Model Pruning and Lightweight
   Networks},
Booktitle = {ADVANCES IN SELF-ORGANIZING MAPS, LEARNING VECTOR QUANTIZATION,
   INTERPRETABLE MACHINE LEARNING, AND BEYOND, WSOM PLUS 2024},
