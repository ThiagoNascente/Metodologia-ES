@article{ WOS:001770412200001,
Author = {Xu, Ouguan and Wang, Songsong and Yang, Zeyu and Ge, Zhiqiang},
Title = {Data-centric process monitoring based on green development of deep
   latent variable model},
Journal = {APPLIED SOFT COMPUTING},
Year = {2026},
Volume = {200},
Month = {AUG},
Abstract = {While deep learning has advanced industrial process monitoring,
   prevailing methods remain model-centric and often overlook the critical
   importance of original data quality. Shifting from low-quality large
   volume data to high-quality small volume data is essential for
   developing trustworthy and resource-efficient industrial AI. To address
   this, we propose a data-centric systems framework that strategically
   integrates a deep latent variable model, data quality evaluation, and
   self-training. To minimize manual annotation expense, the framework
   initializes with a strictly limited set of verified training samples. It
   then autonomously evaluates and incorporates unevaluated data for
   self-training, prioritizing samples with high reliability. Crucially, a
   Critical Reliability Index (CRI) is formulated within the deep model's
   latent space to act as a strict risk-control mechanism, explicitly
   excluding low-quality or ambiguous data to maintain model robustness.
   Both the feasibility and effectiveness of this architecture are
   confirmed through a detailed case study on the TE benchmark industrial
   process. Furthermore, quantitative evaluations demonstrate measurable
   reductions in annotation effort and computational overhead, validating
   the framework as a highly efficient, sustainable Green AI solution for
   process monitoring.},
