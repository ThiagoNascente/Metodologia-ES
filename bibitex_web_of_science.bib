@article{ WOS:001860401800006,
Author = {Choi, Hansom and Lee, Dongseok and Hong, Youngjoon and Kim, Namjung},
Title = {Efficient and Scalable Foundation Model for Metamaterial Design},
Journal = {TRANSACTIONS OF THE KOREAN SOCIETY OF MECHANICAL ENGINEERS A},
Year = {2026},
Volume = {50},
Number = {8},
Pages = {663-671},
Month = {AUG},
Abstract = {Recent advances in AI-driven design have broadened additively
   manufactured structures across scales, enabling applications in
   aerospace, healthcare, and vibration control. Among these, metamaterials
   have shown significant progress, achieving enhanced durability,
   stability, and efficiency through tailored structural architectures.
   Yet, translating these advantages into practice demands efficient
   methods to capture intricate structure-property relationships. However,
   conventional strategies often suffer from high computational costs,
   limited generalization, and noise sensitivity. To address these
   challenges, the metamaterial foundation operator (MetaFO) was recently
   proposed. It demonstrated strong zero-shot design capability, robustness
   to missing data, and effective noise reduction. In this study, we
   introduce a lightweight MetaFO aimed at improving energy efficiency. By
   incorporating binary linear layers, the proposed model preserves
   accuracy while significantly enhancing inference speed and reducing
   computational cost, highlighting its suitability for real-world
   deployment and contribution to sustainable Green AI practices.},
