   through LLM Adaptation},
Booktitle = {INTELLIGENT DATA ENGINEERING AND AUTOMATED LEARNING-IDEAL 2025, PT II},
Series = {Lecture Notes in Computer Science},
Year = {2026},
Volume = {16239},
