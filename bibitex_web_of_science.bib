@article{ WOS:001565839900001,
Author = {Xu, Hao and Chow, Jun Kang and Tan, Pin Siang and Mao, Xin and Liu,
   Kuan-fu and Wang, Yu-Hsing},
Title = {Towards sustainable construction: A cost-effective framework for bird
   monitoring from on-site collected videos leveraging deep active learning
   and synthetic training data},
Journal = {JOURNAL OF CLEANER PRODUCTION},
Year = {2025},
Volume = {524},
Month = {SEP 15},
Abstract = {Construction projects increasingly incorporate bird monitoring into the
   Environmental Impact Assessment (EIA) to promote sustainability.
   However, traditional manual survey methods are labor-intensive,
   intermittent, subject to delays and bias. Additionally, deep
   learning-based data processing often involves substantial annotation
   costs. To address these challenges, this study introduces a
   cost-effective framework that integrates a video capture system, a deep
   learning model, a data synthesis pipeline, and an active learning
   strategy. The Green-AI Camera system enables automated, continuous, and
   long-term avian footage collection with minimal wildlife disturbance.
   Synthetic data from public bird images and diverse backgrounds improved
   pre-training without increasing annotation costs. The active learning
   strategy optimized training by selectively querying uncertain and
   diverse samples. We applied the framework to monitor egrets in an urban
   park. Results indicate that synthetic data significantly improved model
   performance, increasing pre-training average precision (AP) from 0.199
   to 0.398 and boosting mean AP during initial training from 0.919 to
   0.969. Moreover, our active learning strategy demonstrates superior
   cost-effectiveness, outperforming both other active learning methods and
   the random selection approach typically used in conventional AI-based
   bird monitoring. This monitoring provides insights into the population
   trends, activity patterns, and spatial distributions of egrets during
   the breeding season, aiding the EIA for a nearby sewage plant relocation
   project. The framework can be readily generalized to monitor diverse
   birds across various regions and projects, advancing sustainable
   construction and cleaner production.},
