@article{ WOS:001760750800001,
Author = {Ma, Xiaolin and Zhang, Chenglong},
Title = {Exploring the carbon footprint of time-series prediction models},
Journal = {JOURNAL OF CLEANER PRODUCTION},
Year = {2026},
Volume = {561},
Month = {MAY 14},
Abstract = {Artificial intelligence (AI) is advancing rapidly. Nevertheless, its
   pursuit of precision through large-scale computation ({''}red AI{''})
   raises concerns about sustainability. While recent advances in machine
   learning have significantly improved forecasting performance, existing
   research predominantly focuses on accuracy, largely overlooking the
   associated environmental costs. This omission is particularly
   problematic in high-frequency financial forecasting, where continuous
   model training and inference can generate substantial carbon emissions.
   To address this gap, we propose a dual-dimensional evaluation framework
   that jointly assesses predictive performance and carbon emissions. Using
   1-min intervals of Bitcoin data and controlled experiments across model
   architectures (XGBoost, LSTM, and Transformer), hardware configurations,
   data volumes, and learning strategies, we provide a systematic analysis
   of the accuracy-emissions trade-off. The results suggest that when
   considering accuracy and emissions jointly, LSTM is the most effective
   choice. Notably, the configuration employing the four-step prediction
   for one step, which was trained on 80,000 samples, demonstrated the best
   performance, combining high accuracy with moderate carbon cost. This
   work challenges two common assumptions: that larger datasets do not
   necessarily improve accuracy and that high-performance graphics
   processing units are not consistently superior, as lightweight models
   can perform more efficiently on generalpurpose hardware. Together, these
   findings extend research on sustainable AI by highlighting trade-offs
   between accuracy and ecological effects. Overall, this research advances
   the understanding of ``green AI{''} by emphasising the ecological
   effects of algorithmic design. This work underscores the importance of
   integrating environmental considerations into AI practice and
   incorporating green development into AI ethics, enabling more
   energy-conscious and sustainable AI systems.},
