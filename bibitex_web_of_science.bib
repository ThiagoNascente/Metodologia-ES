Year = {2023},
Volume = {23},
Number = {2},
Month = {JAN},
Abstract = {In this paper, we aim to envision 6G convergent terrestrial and
   non-terrestrial infrastructure of virtual emotion and epidemic
   prevention with two differential perspectives: Green AI and Red AI,
   where Green AI focuses on efficiency and reduction, and Red AI
   additionally pursues accuracy. By fitting with each perspective, we
