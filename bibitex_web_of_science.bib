Title = {GreenKube: Carbon-Aware Scheduling of AI Workloads in Kubernetes Using
   GCM and BCAS Algorithms},
Booktitle = {SMART TRENDS IN COMPUTING AND COMMUNICATIONS, SMARTCOM 2026, VOL 6},
Series = {Lecture Notes in Networks and Systems},
Year = {2026},
Volume = {2018},
Pages = {350-365},
Note = {10th International Conference on Smart Trends in Computing and
   Communications-SmartCom, Pune, INDIA, JAN 19-21, 2026},
Organization = {Global Knowledge Research Foundation},
Abstract = {As a result of the exponential growth of cloud native workloads, their
   associated carbon emissions in data centers have outstripped many other
   forms of electric gen eration, including coal. The traditional
   Kubernetes scheduler focuses solely on resource availability and
   performance, with out considering the carbon intensity of the electrical
   supply powering the data center. This leads to suboptimal placement of
   workloads on nodes powered by non-renewable sources. To meet this
   challenge, we present GreenKube, a carbon-conscious scheduling framework
   for Kubernetes that incorporates Green AI concepts to orchestrate
   workloads. The system introduces two intelligent schedulers: Greedy
   Carbon Minimization (GCM), which schedules deployment regions based
   solely on the low est carbon intensity; and Balanced Carbon-Aware
   Scheduling (BCAS), which considers both carbon intensity and latency
   using a tunable weight parameter alpha. We deploy a synthetic carbon
   intensity feed as a REST API microservice that provides real time
   region-specific carbon values. To validate the proposed scheduling
   strategies, we containerized the MobileNetV2 model to run inference
   workloads within the GreenKube framework. Each componentthe carbon-feed,
   scheduler, and AI inference serviceis packaged as a Docker container and
   orchestrated using Kubernetes on Docker Desktop. GCM consistently
   reduces carbon footprint, whereas BCAS provides a better balance between
   sustainability and performance due to significant latency reduction with
   minimal carbon trade-off. Full automation of carbon-optimized job
   placement is achieved using Kubernetes ConfigMaps, node affinity
   constraints, and custom scheduling logic. This study demonstrates
   practical integration of carbon aware scheduling into existing cloud
   infrastructures, contributing to sustainable AI and forming a foundation
   for green cloud computing.},
