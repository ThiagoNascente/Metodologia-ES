   Pati, Amit K. and Kaushik, Keshav and Shukla, Praveen Kumar and Soni,
   Mukesh},
Editor = {Bhattacharya, A and Dutta, S and Jalil, IEA and Rocha, A},
Title = {Edge and Real-Time Computing: Emerging Challenges, Innovations, and
   Applications},
Booktitle = {DATA MINING AND INFORMATION SECURITY, ICDMIS 2025, VOL 2},
